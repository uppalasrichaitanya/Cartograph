# Storage backend (auto-detected):
#   - If BLOB_READ_WRITE_TOKEN is set, Vercel Blob is used (required for Vercel deployments).
#   - If it is empty or absent, local filesystem storage is used (suitable for local development).
BLOB_READ_WRITE_TOKEN=

# Optional server-side AI providers. Cartograph tries them in this order:
# Gemini, Groq, then OpenRouter. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=openrouter/free

# Optional shared rate limits (Upstash Redis). Either naming works; empty means
# per-instance in-memory limits.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
